<Project>

  <PropertyGroup>
    <!-- The product version, in ONE place: /__admin/health reports it and the dashboard's Settings
         screen reads it from there, so this is the only number a release bumps. ui/package.json
         carries its own unrelated version that nothing displays; it drifted from this years ago and
         the instruction to keep them in step was describing work with no effect. -->
    <Version>1.16.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Licensing metadata (Apache-2.0). Applied to any project that later opts into packaging. -->
  <PropertyGroup>
    <Authors>Ömer Çelik</Authors>
    <Copyright>Copyright 2026 Ömer Çelik</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
