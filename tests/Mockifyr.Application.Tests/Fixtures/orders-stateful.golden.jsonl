{"name":"health","request":{"method":"GET","urlPath":"/api/health"},"response":{"status":200,"body":"{\n  \"status\": \"up\"\n}","headers":{"Content-Type":"application/json"}}}
{"name":"list orders","request":{"method":"GET","urlPath":"/api/orders"},"response":{"status":200,"headers":{"Content-Type":"application/json"},"body":"{\"count\":{{state.count}},\"items\":{{state.list}} }","state":{"operation":"list","collection":"orders"}}}
{"name":"create orders","request":{"method":"POST","urlPath":"/api/orders"},"response":{"status":201,"headers":{"Location":"{{request.path}}/{{state.id}}"},"body":"{{state.body}}","state":{"operation":"create","collection":"orders"}}}
{"name":"read orders","request":{"method":"GET","urlPathTemplate":"/api/orders/{orderId}"},"response":{"status":200,"state":{"operation":"read","collection":"orders","id":"{{request.pathSegments.[2]}}"},"headers":{"Content-Type":"application/json"},"body":"{{state.body}}"}}
{"name":"update orders","request":{"method":"PUT","urlPathTemplate":"/api/orders/{orderId}"},"response":{"status":200,"state":{"operation":"update","collection":"orders","id":"{{request.pathSegments.[2]}}"},"headers":{"Content-Type":"application/json"},"body":"{{state.body}}"}}
{"name":"delete orders","request":{"method":"DELETE","urlPathTemplate":"/api/orders/{orderId}"},"response":{"status":204,"state":{"operation":"delete","collection":"orders","id":"{{request.pathSegments.[2]}}"}}}
{"name":"getInvoice","request":{"method":"GET","urlPathTemplate":"/api/orders/{orderId}/invoice"},"response":{"status":200,"body":"{\"url\":\"{{random 'Internet.url'}}\",\"issued\":\"2026-01-01\"}","headers":{"Content-Type":"application/json"},"transformers":["response-template"]}}
