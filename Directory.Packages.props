<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS mediator (management path only — see docs/decisions/0005) -->
    <PackageVersion Include="Mediant" Version="1.1.0" />
    <!-- JSONPath: Newtonsoft's dialect is the closest .NET proxy for WireMock's Jayway JsonPath
         (accepts `[?(@.x=='y')]`-style filters). Used only inside Mockifyr.Matching. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- JSON Schema validation for matchesJsonSchema (G1h). json-everything's JsonSchema.Net is the
         MIT-licensed .NET validator with Draft 6/7/2019-09/2020-12 support. Used only inside
         Mockifyr.Matching. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.2.2" />
    <!-- GraphQL query normalization for the GraphQL matcher (G14). GraphQL-Parser is graphql-dotnet's
         lexer/parser/printer; used only inside Mockifyr.Matching. -->
    <PackageVersion Include="GraphQL-Parser" Version="9.5.1" />
    <!-- Response templating (G2b). Handlebars.Net mirrors WireMock's jknack Handlebars engine.
         Used only inside Mockifyr.Templating. -->
    <PackageVersion Include="Handlebars.Net" Version="2.1.6" />
    <!-- Fake-data generation for the Faker/random helper (G15). Bogus is the .NET counterpart of the
         Datafaker library WireMock's faker extension uses. Used only inside Mockifyr.Templating. -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <!-- OpenAPI import (G19c, ADR 0011). Microsoft.OpenApi.Readers parses 3.0/3.1 (JSON + YAML);
         MIT-licensed, used only inside Mockifyr.Adapters.OpenApi — never referenced by Core. -->
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.23" />
    <!-- gRPC facade (G13). Google.Protobuf drives generic protobuf <-> JSON via the descriptor;
         Grpc.AspNetCore hosts the gRPC endpoint. Used only inside Mockifyr.Facade.Grpc. -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.81.1" />
    <!-- SMTP capture facade (G18b, ADR 0009). MimeKit parses the DATA payload into a MessageEnvelope;
         MIT-licensed, used only inside Mockifyr.Facade.Smtp — Core never sees MIME. -->
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <!-- Real SMTP client for the G18b self-test (no oracle exists: WireMock has no SMTP). Tests only. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- Official Twilio SDK for the G18d self-test: the SDK must accept our provider-profile responses.
         Tests only — the shipped profile emulates the wire format without any Twilio dependency. -->
    <PackageVersion Include="Twilio" Version="7.14.9" />
    <!-- Embedded persistence provider (G16b). LiteDB is a single-file .NET document store; used only
         inside Mockifyr.Server behind the IStubPersistence seam. -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <!-- SQL persistence provider (G16c). Npgsql is the .NET PostgreSQL driver; used only inside
         Mockifyr.Server behind the IStubPersistence seam. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Key-value persistence provider (G16d). StackExchange.Redis is the .NET Redis client; used only
         inside Mockifyr.Server behind the IStubPersistence seam. -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

  <ItemGroup Label="Testing / harness">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Differential harness: runs the real Java WireMock oracle in a container. -->
    <PackageVersion Include="Testcontainers" Version="4.12.0" />
    <!-- In-memory test host for the admin HTTP facade differential (G7b). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Real PostgreSQL container for the persistence differential (G16c). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!-- Real Redis container for the persistence differential (G16d). -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.12.0" />
    <!-- gRPC client to drive the G13 differential against both sides. -->
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
  </ItemGroup>

</Project>
